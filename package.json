{
  "name": "lifeos-pocket",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "package:pocket": "npm run build && python scripts/package-pocket.py",
    "test:static": "node scripts/smoke-static.mjs",
    "typecheck:notify": "tsc --noEmit -p workers/notify/tsconfig.json && tsc --noEmit -p functions/tsconfig.json",
    "test:notify": "node scripts/test-notifications.mjs"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261114.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.0.0",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.0.0",
    "miniflare": "^4.20260730.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "^7.30.1",
      "sharp": "^0.35.5"
    }
  },
  "version": "3.0.0"
}
